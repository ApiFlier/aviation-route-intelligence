# FlightConn — User-supplied configuration
# =========================================
# Copy this file to deploy.env and fill in your values.
#
#   cp deploy.env.example deploy.env
#
# deploy.env is listed in .gitignore and must NEVER be committed.
# setup.sh reads deploy.env (if present) and merges values into .env.
#
# If deploy.env does not exist, setup.sh runs normally with auto-generated
# credentials. You only need deploy.env to:
#   - Pin a specific APP_PORT instead of letting setup.sh auto-discover one
#   - Enable the optional FAA SWIM ingestor sidecar
#
# The main app (Route Map, Route Opportunity Finder, Airline Health) runs
# fully without any values in this file.

# ── App Port (optional) ───────────────────────────────────────────────────────
# If set, setup.sh will use this port instead of auto-discovering one.
# If the port is in use, setup.sh will still increment to find a free port.
# Leave blank to let setup.sh pick automatically (starting at 8082).
# APP_PORT=8082

# ── FAA SWIM Ingestor ─────────────────────────────────────────────────────────
# Set to true only if you have FAA SWIM credentials from the FAA SWIM program.
# When false (the default), the SWIM ingestor is not started and the FAA
# fields below are not required.
#
# FAA SWIM access requires a completed SWIM Service Access Agreement (SAA):
#   https://www.faa.gov/air_traffic/technology/swim
ENABLE_SWIM_INGESTOR=false

# ── FAA Broker URL (optional — has a working default) ────────────────────────
# The default points to the FAA SWIM Cloud Distribution Service (SCDS) broker.
# Only change this if FAA provides a different broker URL for your account.
FAA_URL=tcps://ems1.swim.faa.gov:55443

# ── FAA Credentials (required only when ENABLE_SWIM_INGESTOR=true) ───────────
# Issued by FAA after a completed SWIM SAA. Never commit these values.
FAA_USER=
FAA_PASS=

# ── SWIM Queue Names (required only when ENABLE_SWIM_INGESTOR=true) ──────────
# Queue names are assigned by FAA after account setup. At least one is required.
# SFDPS  — System Flight Data Processing System (en-route/oceanic flight data)
# STDDS  — SWIM Terminal Data Distribution System
# TFMS   — Traffic Flow Management System (departure/arrival estimates, flow data)
QUEUE_SFDPS=
QUEUE_STDDS=
QUEUE_TFMS=

# ── SWIM Probe Mode ───────────────────────────────────────────────────────────
# When ENABLE_SWIM_INGESTOR=true, the sidecar runs a bounded connection probe
# by default (SWIM_PROBE_ONLY=true). This validates credentials and queue access
# without enabling continuous ingestion. Set to false only when you are ready
# for Phase 2B continuous ingestion (not yet implemented).
SWIM_PROBE_ONLY=true
SWIM_PROBE_SECONDS=30
SWIM_PROBE_MAX_MESSAGES=5

# ── SWIM Advanced Options (optional — defaults are sensible) ─────────────────
# SWIM_SSL_VERIFY: set false only for initial connectivity testing when the
# FAA broker uses a self-signed certificate. Never use false in production.
SWIM_SSL_VERIFY=true
SWIM_DEST_PREFIX=/queue/
SWIM_HEARTBEAT_MS=4000
SWIM_LOOKBACK_DAYS=30
SWIM_RETENTION_DAYS=35
SWIM_RAW_RETENTION_DAYS=14
SWIM_LOG_LEVEL=INFO
