# FlightConn — FAA SWIM Ingestor Environment Variables (legacy form)
# ===================================================================
# PREFERRED: Use deploy.env.example instead.
#
#   cp deploy.env.example deploy.env
#
# deploy.env is the unified config file read by setup.sh. It covers both the
# main app (APP_PORT) and the optional SWIM sidecar in one place.
#
# swim.env is supported for backward compatibility when using the manual
# docker-compose.swim.yml overlay without setup.sh. It is listed in .gitignore
# and must NEVER be committed.
#
# FAA credentials must never appear in version control, logs, or Docker images.
#
# The core FlightConn app (Route Map, Opportunities, Airline Health) runs
# normally without any of these variables. Only the optional SWIM sidecar
# uses them.
#
# Setting SWIM_ENABLED=true without valid FAA credentials will not enable
# ingestion — the sidecar will log what is missing and exit cleanly.

# ── Master Switch ─────────────────────────────────────────────────────────────
# Leave as false until FAA credentials are confirmed and tested.
SWIM_ENABLED=false

# ── FAA SWIM Credentials ──────────────────────────────────────────────────────
# Issued by FAA after a completed SWIM Service Access Agreement (SAA).
# See: https://www.faa.gov/air_traffic/technology/swim
# Never commit these values.
FAA_USER=
FAA_PASS=

# ── FAA SWIM Broker Address ───────────────────────────────────────────────────
# Provided by FAA after account approval (your SWIM/SCDS account documentation).
# Set FAA_SWIM_BROKER_URL as a single value, OR use the split form below.
# The broker uses Solace PubSub+ with STOMP over TLS (default port 61614).

# Option A — single URL (preferred):
# Expected format: ssl://hostname:61614
FAA_SWIM_BROKER_URL=

# Option B — split host/port/protocol (useful when copy-pasting from FAA docs):
# FAA_SWIM_HOST, FAA_SWIM_PORT, and FAA_SWIM_PROTOCOL are ignored if
# FAA_SWIM_BROKER_URL is set.
# FAA_SWIM_PROTOCOL: ssl (default) | tcp — controls TLS and default port.
FAA_SWIM_HOST=
FAA_SWIM_PORT=
FAA_SWIM_PROTOCOL=ssl

# ── SWIM Queue Names ──────────────────────────────────────────────────────────
# Queue names are assigned by FAA after account setup.
# Set one or more. At least one must be present to activate ingestion.
#
# SFDPS  — System Flight Data Processing System (en-route/oceanic flight data)
# STDDS  — SWIM Terminal Data Distribution System
# TFMS   — Traffic Flow Management System (departure/arrival estimates, flow data)
QUEUE_SFDPS=
QUEUE_STDDS=
QUEUE_TFMS=

# ── Config Check and Probe Mode (Phase 2A) ───────────────────────────────────
# SWIM_CONFIG_CHECK_ONLY=true: validate config and print a redacted summary,
# then exit without connecting to FAA. Useful for verifying that all required
# variables are present before running a probe.
SWIM_CONFIG_CHECK_ONLY=false

# SWIM_PROBE_ONLY=true: run a bounded connection test and exit.
# Useful for validating credentials and confirming queue access before
# enabling continuous ingestion.
SWIM_PROBE_ONLY=false
SWIM_PROBE_SECONDS=30
SWIM_PROBE_MAX_MESSAGES=5

# ── Advanced Connection Options ───────────────────────────────────────────────
# SWIM_SSL_VERIFY: set false only for initial connectivity testing when
# the FAA broker uses a self-signed or non-standard TLS certificate.
# Never use false in production.
SWIM_SSL_VERIFY=true

# SWIM_DEST_PREFIX: STOMP queue destination prefix.
# Default /queue/ is correct for Solace PubSub+ queue endpoints.
# Change only if FAA provides a different destination format.
SWIM_DEST_PREFIX=/queue/

# SWIM_HEARTBEAT_MS: STOMP heartbeat negotiation interval in milliseconds.
# Default 4000ms. Increase on high-latency connections.
SWIM_HEARTBEAT_MS=4000

# ── Retention Settings ────────────────────────────────────────────────────────
# How long to keep data in each layer. Adjust based on available disk.
SWIM_LOOKBACK_DAYS=30
SWIM_RETENTION_DAYS=35
SWIM_RAW_RETENTION_DAYS=14

# ── Logging ───────────────────────────────────────────────────────────────────
SWIM_LOG_LEVEL=INFO
