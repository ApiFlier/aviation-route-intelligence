# FlightConn — FAA SWIM Ingestor Environment Variables
# ======================================================
# Copy this file to swim.env and fill in your credentials.
#
#   cp swim.env.example swim.env
#
# swim.env is listed in .gitignore and must NEVER be committed.
# FAA credentials must never appear in version control, logs, or Docker images.
#
# The core FlightConn app (Route Map, Opportunities, Airline Health) runs
# normally without any of these variables. Only the optional SWIM sidecar
# uses them.
#
# Setting SWIM_ENABLED=true without valid FAA credentials will not enable
# ingestion — the sidecar will log what is missing and exit cleanly.

# ── Master Switch ─────────────────────────────────────────────────────────────
# Leave as false until FAA credentials are confirmed and tested.
SWIM_ENABLED=false

# ── FAA SWIM Credentials ──────────────────────────────────────────────────────
# Issued by FAA after a completed SWIM Service Access Agreement (SAA).
# See: https://www.faa.gov/air_traffic/technology/swim
# Never commit these values.
FAA_USER=
FAA_PASS=

# ── FAA SWIM Broker URL ───────────────────────────────────────────────────────
# Provided by FAA after account approval. Format varies by access tier.
# Example format (not a real endpoint — yours will differ):
#   FAA_SWIM_BROKER_URL=ssl://swim-broker.example.faa.gov:61617
FAA_SWIM_BROKER_URL=

# ── SWIM Queue Names ──────────────────────────────────────────────────────────
# Specific queue names are provided by FAA after account setup.
# Set one or more. At least one must be present to activate ingestion.
#
# SFDPS  — System Flight Data Processing System (en-route flight data)
# STDDS  — SWIM Terminal Data Distribution System
# TFMS   — Traffic Flow Management System (departure/arrival estimates)
QUEUE_SFDPS=
QUEUE_STDDS=
QUEUE_TFMS=

# ── Retention Settings ────────────────────────────────────────────────────────
# How long to keep data in each layer. Adjust based on available disk.
# Raw messages are short-retention debug data; summaries are kept longer.
SWIM_LOOKBACK_DAYS=30
SWIM_RETENTION_DAYS=35
SWIM_RAW_RETENTION_DAYS=14

# ── Logging ───────────────────────────────────────────────────────────────────
SWIM_LOG_LEVEL=INFO
